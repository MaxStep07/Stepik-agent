# Провайдер LLM: "openai" (Groq, OpenRouter, DeepSeek, Ollama) или "gemini"
LLM_PROVIDER=openai

# Настройки OpenAI-совместимого API (пример для Groq)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=qwen/qwen3.8-27b
OPENAI_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Настройки Gemini API (если LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=

# Cookies авторизации из браузера на stepik.org
STEPIK_SESSION_ID=your_sessionid_here
STEPIK_CSRF_TOKEN=your_csrftoken_here

# ID курса (число из URL: https://stepik.org/course/67/syllabus -> 67)
STEPIK_COURSE_ID=67

# Лимиты и задержки между запросами
MAX_ATTEMPTS_PER_STEP=4
MIN_DELAY_SEC=1.5
MAX_DELAY_SEC=3.5